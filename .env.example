# Google Gemini / Vertex AI
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# us-central1 for Agent Engine deploy region; use global for gemini-3.5-flash inference
GOOGLE_CLOUD_LOCATION=global
# Vertex mode (GOOGLE_GENAI_USE_VERTEXAI=TRUE): use ADC, not API keys.
#   gcloud auth application-default login
#   gcloud services enable aiplatform.googleapis.com
# Gemini API mode (GOOGLE_GENAI_USE_VERTEXAI=FALSE): set GOOGLE_API_KEY only.
GOOGLE_API_KEY=your-google-api-key
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Agent Engine (set after: make deploy-agent)
# Full resource name, e.g. projects/.../locations/.../reasoningEngines/...
AGENT_ENGINE_RESOURCE_ID=
# Region where Agent Engine is deployed (Gemini may still use global).
AGENT_ENGINE_REGION=us-central1

# Arize Phoenix Cloud
PHOENIX_API_KEY=your-phoenix-api-key
PHOENIX_COLLECTOR_ENDPOINT=https://your-instance.phoenix.arize.com
PHOENIX_PROJECT_NAME=clinictrace
# Phoenix Cloud UI uses Global ID, not name — list via: client.projects or GET v1/projects
PHOENIX_PROJECT_ID=your-phoenix-project-global-id

# NHAMCS lab — sample cases from BigQuery (fast). Set NHAMCS_USE_LOCAL=true to force Stata.
BQ_NHAMCS_TABLE=black-tenure-439907-v8:clinictrace.ed_triage

# Speed: inline skills (default) avoids load_skill round-trip per agent.
INLINE_SKILLS=true
# Merge ESI+red-flag into one LLM; deterministic audit (3 pipeline LLMs + judge).
MERGE_TRIAGE_LLM_STEPS=true
# NHAMCS UI: true = instant green/orange/red banner from ESI vs IMMEDR.
# false = full LLM quality judge (~10–15s extra).
UI_SKIP_QUALITY_EVAL=true
# Manual intake (/triage): true = LLM quality judge after each run.
UI_INTAKE_LLM_QUALITY_EVAL=true
# Models (Vertex) — gemini-3.5-flash for pipeline + optional quality judge
CLINICTRACE_MODEL=gemini-3.5-flash
GEMINI_EVAL_MODEL=gemini-3.5-flash
# Fallback if 3.5 not enabled in your project: gemini-2.5-flash

# Remote Phoenix MCP (Cloud Run Streamable HTTP) — use with Agent Engine.
# Deploy: make deploy-phoenix-mcp  (creates Secret Manager secrets + Cloud Run)
# Secrets: clinictrace-phoenix-api-key, clinictrace-mcp-service-api-key
PHOENIX_MCP_URL=
PHOENIX_MCP_SERVICE_KEY=
# Bearer token for MCP HTTP (stored in Secret Manager; same value as SERVICE_KEY).
MCP_SERVICE_API_KEY=
# Optional overrides for Secret Manager secret ids:
# SECRET_PHOENIX_API_KEY=clinictrace-phoenix-api-key
# SECRET_MCP_SERVICE_KEY=clinictrace-mcp-service-api-key
# PHOENIX_MCP_SERVICE_NAME=clinictrace-phoenix-mcp
# GCP_REGION=us-central1

# Latency: FAST_TRIAGE=true uses REST feedback (no extra LLM). Set false for
# full Phoenix MCP + LLM feedback (slower). PHOENIX_MCP_ENRICH=true adds MCP
# on audit reporter alongside fast REST. PHOENIX_MCP_FEEDBACK=true enables
# local stdio MCP when PHOENIX_MCP_URL is unset (npx).
FAST_TRIAGE=true
PHOENIX_MCP_FEEDBACK=false
PHOENIX_MCP_ENRICH=false
# Blocks local npx MCP only; remote PHOENIX_MCP_URL still works when set.
DISABLE_PHOENIX_MCP=false
